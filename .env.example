# Comma-separated list of origins allowed to call /api/scan from browser JS
# (e.g. your Shopify storefront). Needed for the Shopify embed to work — see
# SHOPIFY.md. Leave unset to block all cross-origin browser calls (server-to-
# server calls, and this app's own frontend, are unaffected either way).
#
# ALLOWED_ORIGINS=https://mystore.com,https://mystore.myshopify.com

# Google PageSpeed Insights API key. Optional — /api/pagespeed works without
# one, but unauthenticated requests share a very small global quota and will
# get rate-limited quickly under real traffic. Get a free key in about a
# minute: console.cloud.google.com -> create/select a project -> APIs &
# Services -> Library -> enable "PageSpeed Insights API" -> Credentials ->
# Create API Key. Free tier is 25,000 requests/day, no billing required.
#
# GOOGLE_PAGESPEED_API_KEY=your-key-here

# AI visibility check (/api/ai-visibility) — queries each provider's own API
# directly, no data-reseller markup. Every provider below is independently
# optional: leave any of them unset and that provider just shows as "not
# configured" in the results instead of failing the whole check. At least one
# must be set for the feature to do anything.
#
# OpenAI: platform.openai.com -> API keys -> Create new secret key.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5-mini   # optional override, defaults to gpt-5-mini
#
# Anthropic: console.anthropic.com -> API Keys -> Create Key.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001   # optional override
#
# Google Gemini: aistudio.google.com/apikey -> Create API key.
# GEMINI_API_KEY=your-key-here
# GEMINI_MODEL=gemini-3.5-flash   # optional override
#
# Perplexity: perplexity.ai/settings/api -> Generate API key.
# PERPLEXITY_API_KEY=pplx-...
# PERPLEXITY_MODEL=sonar   # optional override
#
# Note: model names shift over time — if a provider starts returning errors,
# check their current docs for the latest valid model name and set the
# *_MODEL override above.

# SEO rank check (/api/seo-rank) — powered by Serper.dev, a pay-as-you-go
# Google SERP API. Sign up at serper.dev (free tier: 2,500 credits, no card
# required), grab the API key from the dashboard.
#
# SERPER_API_KEY=your-key-here

# Free-scan-then-email gate (lib/gate.ts). Required for every scan route —
# without it, /api/lead can't sign the "verified" token and returns a 500.
# Generate a random secret once and never change it (rotating it invalidates
# every already-issued verified token, logging out anyone who unlocked
# scans): `openssl rand -hex 32`
#
# GATE_SECRET=your-random-secret-here

# Redis, via Vercel Marketplace -> Upstash (Storage tab -> Marketplace
# Database Providers -> Upstash -> create a Redis database -> connect it to
# this project). Vercel KV as a standalone product is discontinued; Upstash
# via Marketplace is its replacement and injects the same env var names.
# Backs the free-scan gate (how many free scans an IP has used), which needs
# state shared across serverless instances rather than per-instance memory.
# Auto-injected by Vercel when you connect the database to this project —
# you shouldn't need to set these by hand except for local dev against a
# real instance.
#
# KV_REST_API_URL=https://your-instance.upstash.io
# KV_REST_API_TOKEN=your-token
# KV_REST_API_READ_ONLY_TOKEN=your-readonly-token

# Shopify lead capture (lib/shopify.ts, /api/lead) — writes each validated
# email to Shopify as a customer tagged "marketpulse-lead". Optional in the
# sense that the gate itself still works without it (recordLead failures are
# non-blocking), but no leads will land in your customer list until it's set.
#
# 1. Create the app in the Dev Dashboard (dev.shopify.com/dashboard), same
#    org as the store. Scopes: read_customers, write_customers.
# 2. Install it on your store.
# 3. Settings -> Client credentials -> copy Client ID + Secret.
#
# SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
# SHOPIFY_CLIENT_ID=your-client-id
# SHOPIFY_CLIENT_SECRET=your-client-secret
# SHOPIFY_API_VERSION=2026-07   # optional override
